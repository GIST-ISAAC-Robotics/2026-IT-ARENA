* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.xml text eol=lf
*.sdf text eol=lf
*.xacro text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

*.png binary
*.pdf binary
*.zip binary

# Preserve the organizer package exactly as received / extracted. Its internal
# whitespace is source evidence, not something for Git to normalize or lint.
assets/track/** -text -whitespace
