                                  [--record-follow-decisions]
                                  [--g1-corridor-fallback] [--g1-race-path]
                                  [--g1-recent-observation]
                                  [--partial-observation-policy {strict,bounded_side_v1,bounded_local_v2,bounded_local_v3,bounded_local_v4}]
