+    for radius,angles,lo,hi in _query_brackets(q,origins,directions):
+        if np.any(radius<=1e-9):return reject('query_at_sensor_origin')
+        if (angles[lo]<-1e-10 or angles[hi]>1e-10 or abs(lo-hi)>1
