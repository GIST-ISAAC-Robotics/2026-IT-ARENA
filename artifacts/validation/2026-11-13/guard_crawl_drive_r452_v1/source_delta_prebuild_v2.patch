+        self.assertIs(n.runtime_dual_selected,True)
+
+    def test_capability_cannot_replace_native_runtime_or_r396_selection(self):
+        for fault in ('runtime_off','inline','old_submission','no_retain','python','no_recheck','corner_off','verified'):
+            n=selected(self.boundary['G1G2Node'],ESTIMATED_SCOPE)
+            args=[POLICY,'process_candidate','fresh_native_v1',True,'native_v1']
+            if fault=='runtime_off':args[0]='off'
+            elif fault=='inline':args[1]='inline'
+            elif fault=='old_submission':args[2]='original_v1'
+            elif fault=='no_retain':args[3]=False
+            elif fault=='python':args[4]='python'
+            elif fault=='no_recheck':n.recheck_in_worker=False
+            elif fault=='corner_off':n.current_corner_budget='off'
+            elif fault=='verified':n.motion.verified=True
+            with self.subTest(fault=fault),self.assertRaises(ValueError):
+                self.boundary['runtime_checks'](n,*args)
+
+    def test_simulation_subclass_keeps_registered_runtime_checks(self):
+        n=selected(self.boundary['G1G2Node'],SIMULATION_SCOPE)
+        self.boundary['runtime_checks'](n,POLICY,'process_candidate','fresh_native_v1',True,'native_v1')
+        self.assertTrue(n.runtime_dual_selected)
+
+    def test_independent_guard_selection_does_not_require_planner_capability(self):
+        n=selected(self.boundary['G1G2Node'],ESTIMATED_SCOPE)
+        n.estimated_observation_runtime_capable=False
+        validate_node_selection(n,True,observation_scope=ESTIMATED_SCOPE)
