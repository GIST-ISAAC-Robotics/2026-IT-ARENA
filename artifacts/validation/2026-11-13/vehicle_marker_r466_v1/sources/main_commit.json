C%ED%84%B0%EC%BC%9C%EA%B8%B0.3mf?ref=6c2589c61acb83928339291ae237180b17c2cb54"},{"sha":"500d1ef07a2e18a9e9305781770e1680acee64f0","filename":"parts/traffic_light/print/판2_나머지.3mf","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/MOSW626/istech-it-arena/blob/6c2589c61acb83928339291ae237180b17c2cb54/parts%2Ftraffic_light%2Fprint%2F%ED%8C%902_%EB%82%98%EB%A8%B8%EC%A7%80.3mf","raw_url":"https://github.com/MOSW626/istech-it-arena/raw/6c2589c61acb83928339291ae237180b17c2cb54/parts%2Ftraffic_light%2Fprint%2F%ED%8C%902_%EB%82%98%EB%A8%B8%EC%A7%80.3mf","contents_url":"https://api.github.com/repos/MOSW626/istech-it-arena/contents/parts%2Ftraffic_light%2Fprint%2F%ED%8C%902_%EB%82%98%EB%A8%B8%EC%A7%80.3mf?ref=6c2589c61acb83928339291ae237180b17c2cb54"},{"sha":"831409d096cc77ffe048b2868a637cc7cf77371f","filename":"parts/traffic_light/split.png","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/MOSW626/istech-it-arena/blob/6c2589c61acb83928339291ae237180b17c2cb54/parts%2Ftraffic_light%2Fsplit.png","raw_url":"https://github.com/MOSW626/istech-it-arena/raw/6c2589c61acb83928339291ae237180b17c2cb54/parts%2Ftraffic_light%2Fsplit.png","contents_url":"https://api.github.com/repos/MOSW626/istech-it-arena/contents/parts%2Ftraffic_light%2Fsplit.png?ref=6c2589c61acb83928339291ae237180b17c2cb54"},{"sha":"a2a581a5ec41b8c6709f02588533b932b730e62d","filename":"parts/traffic_light/split_signal.py","status":"added","additions":82,"deletions":0,"changes":82,"blob_url":"https://github.com/MOSW626/istech-it-arena/blob/6c2589c61acb83928339291ae237180b17c2cb54/parts%2Ftraffic_light%2Fsplit_signal.py","raw_url":"https://github.com/MOSW626/istech-it-arena/raw/6c2589c61acb83928339291ae237180b17c2cb54/parts%2Ftraffic_light%2Fsplit_signal.py","contents_url":"https://api.github.com/repos/MOSW626/istech-it-arena/contents/parts%2Ftraffic_light%2Fsplit_signal.py?ref=6c2589c61acb83928339291ae237180b17c2cb54","patch":"@@ -0,0 +1,82 @@\n+\"\"\"signal_610_old_style.stl -> P1S(256 mm)용 분할 STL + 이음 슬리브.\n+\n+    ~/miniforge3/bin/python parts/traffic_light/split_signal.py\n+\n+자르는 곳 (도로 중심 기준): 가로대 x=±120, ±320 / 기둥 높이 40, 232.\n+기둥을 세워 뽑으면 232 mm 막대가 흔들려 떨어지기 쉬워서, 발판만 짧게 세우고 나머지는 전부 눕힌다.\n+자른 면은 전부 15 x 14.6 mm 사각 봉이라, 슬리브(사각 관)를 씌우고 순간접착제로 붙인다.\n+\"\"\"\n+import os\n+import numpy as np\n+import trimesh\n+import manifold3d as mf\n+\n+HERE = os.path.dirname(os.path.abspath(__file__))\n+OUT = os.path.join(HERE, \"print\")\n+CUT_X = (120.0, 320.0)       # 가로대 자르는 곳 (|x|)\n+CUT_H = 232.0                # 기둥 자르는 높이 (모서리 조각 아래)\n+CUT_FOOT = 40.0              # 발판 조각 높이\n+CLR, WALL, SLEEVE_L = 0.2, 3.0, 40.0\n+BIG = 2000.0\n+\n+\n+def to_m(t):\n+    return mf.Manifold(mf.Mesh(vert_properties=np.asarray(t.vertices, np.float32),\n+                               tri_verts=np.asarray(t.faces, np.uint32)))\n+\n+\n+def to_t(m):\n+    g = m.to_mesh()\n+    return trimesh.Trimesh(g.vert_properties[:, :3], g.tri_verts)\n+\n+\n+def box(x0, x1, y0, y1, z0=-BIG, z1=BIG):\n+    return mf.Manifold.cube([x1 - x0, y1 - y0, z1 - z0]).translate([x0, y0, z0])\n+\n+\n+def main():\n+    src = trimesh.load(os.path.join(HERE, \"signal_610_old_style.stl\"))\n+    lo, hi = src.bounds\n+    src.apply_translation([-(lo[0] + hi[0]) / 2, -lo[1], 0])   # x: 도로 중심 0, y: 높이(바닥 0)\n+    full = to_m(src)\n+    a, b = CUT_X\n+    pieces = {   # 이름: (잘라낼 영역, 눕히는 방식)\n+        \"1_가운데_가로대+신호모듈\": (box(-a, a, -BIG, BIG), \"flat\"),\n+        \"2_가로대_왼쪽\": (box(-b, -a, -BIG, BIG), \"flat\"),\n+        \"2_가로대_오른쪽\": (box(a, b, -BIG, BIG), \"flat\"),\n+        \"3_모서리_왼쪽\": (box(-BIG, -b, CUT_H, BIG), \"flat\"),\n+        \"3_모서리_오른쪽\": (box(b, BIG, CUT_H, BIG), \"flat\"),\n+        \"4_기둥_왼쪽\": (box(-BIG, -b, CUT_FOOT, CUT_H), \"flat\"),\n+        \"4_기둥_오른쪽\": (box(b, BIG, CUT_FOOT, CUT_H), \"flat\"),\n+        \"5_발판_왼쪽\": (box(-BIG, -b, -BIG, CUT_FOOT), \"up\"),\n+        \"5_발판_오른쪽\": (box(b, BIG, -BIG, CUT_FOOT), \"up\"),\n+    }\n+    os.makedirs(OUT, exist_ok=True)\n+    for f in os.listdir(OUT):\n+        if f.endswith(\".stl\"):\n+            os.remove(os.path.join(OUT, f))\n+    vol = 0.0\n+    for name, (region, how) in pieces.items():\n+        p = to_t(full ^ region)\n+        vol += p.volume\n+        if how == \"up\":                       # 발판을 바닥에: 높이(y) -> z\n+            p.apply_transform(trimesh.transformations.rotation_matrix(np.pi / 2, [1, 0, 0]))\n+        p.apply_translation(-p.bounds[0])\n+        e = p.extents\n+        assert max(e[0], e[1]) <= 245 and e[2] <= 250, (name, e)\n+        p.export(os.path.join(OUT, f\"{name}_1개.stl\"))\n+        print(f\"{name}: {e[0]:.0f} x {e[1]:.0f} x {e[2]:.0f} mm\")\n+    assert abs(vol - src.volume) < 1e-3 * src.volume, (vol, src.volume)   # 빠진 조각 없음\n+\n+    # 슬리브: 봉 단면(가로대 h 450~465, z -20.8~-6.2)을 재서 안쪽 치수 결정\n+    bar = to_t(full ^ box(150, 300, -BIG, BIG))\n+    w, d = bar.extents[1], bar.extents[2]\n+    iw, idp = w + 2 * CLR, d + 2 * CLR\n+    tube = (mf.Manifold.cube([iw + 2 * WALL, idp + 2 * WALL, SLEEVE_L])\n+            - mf.Manifold.cube([iw, idp, SLEEVE_L + 2]).translate([WALL, WALL, -1]))\n+    to_t(tube).export(os.path.join(OUT, \"6_이음슬리브_8개.stl\"))\n+    print(f\"슬리브: 봉 {w:.1f} x {d:.1f} -> 안쪽 {iw:.1f} x {idp:.1f}, 길이 {SLEEVE_L:.0f}\")\n+\n+\n+if __name__ == \"__main__\":\n+    main()"}]}