+    black=float(np.median(warped[border]));white=float(np.median(samples[bits]))
+    threshold=(black+white)/2
+    border_fraction=float(np.mean(warped[border]<threshold))
+    bit_fraction=float(np.mean((samples>=threshold)==bits))
