+        [sy*cp,sy*sp*sr+cy*cr,sy*sp*cr-cy*sr],[-sp,cp*sr,cp*cr]])
+    return rotation @ np.array([[0.,0.,1.],[-1.,0.,0.],[0.,-1.,0.]])
+
+
+def rectangle(rear_xy, heading):
