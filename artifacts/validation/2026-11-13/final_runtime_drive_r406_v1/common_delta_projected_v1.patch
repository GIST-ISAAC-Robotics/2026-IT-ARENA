+def anchor_error(details, config):
+    """경계 앵커 오차. 기본 OFF 선택형 경로는 원점에서 생성 경로 선분까지의 거리를 쓴다.
+
+    직각 벽을 원호로 도는 차는 벽 y좌표가 오프셋과 달라도 경로 위에 있다. 같은 코너가
+    한 모서리 표현(piecewise_corner)과 일반 곡선(wall_model 없음) 사이를 오가도 같은 지표를 쓴다.
+    근접 장애물 여유가 아니므로 앵커 판정에만 쓴다. 값이 없거나 다른 모델이면 기존 벽 거리 대조,
+    비유한/음수는 거부한다.
+    """
+    if (config.piecewise_wall_trial and details.get('wall_model') in (None, 'piecewise_corner')
+            and 'path_anchor_error_m' in details):
+        try:
+            value = float(details['path_anchor_error_m'])
+        except (TypeError, ValueError):
+            return math.inf
+        return value if math.isfinite(value) and value >= 0. else math.inf
+    return abs(details['wall_distance_m']-config.wall_offset_m)
+
+
+def path_agrees(candidate, reference, tolerance):
+    """실제로 겹치는 가까운 전방 구간의 대칭 거리.
+
+    가림으로 한쪽 경로가 짧을 때 다른 쪽에만 있는 구간의 끝점 거리를
+    형상 오차로 세지 않는다. 공통 구간도 0.25 m/각 5점을 요구하며
+    외삽·보간·미관측 채우기를 하지 않는다. 점유 검사는 별도로 유지한다.
+    """
+    paths = [np.asarray(p)[(np.asarray(p)[:, 0] >= .05) & (np.asarray(p)[:, 0] <= .65)]
+             for p in (candidate, reference)]
+    if any(len(p) < 5 or np.ptp(p[:, 0]) < .25 for p in paths):
+        return False
+    lo = max(float(np.min(p[:, 0])) for p in paths)
+    hi = min(float(np.max(p[:, 0])) for p in paths)
+    if hi-lo < .25:
+        return False
+    paths = [p[(p[:, 0] >= lo-1e-12) & (p[:, 0] <= hi+1e-12)] for p in paths]
+    if any(len(p) < 5 or np.ptp(p[:, 0]) < .25 for p in paths):
+        return False
+    distances = np.linalg.norm(paths[0][:, None, :]-paths[1][None, :, :], axis=2)
+    return max(np.percentile(np.min(distances, axis=0), 80),
+               np.percentile(np.min(distances, axis=1), 80)) <= tolerance
+
+
+def path_agrees_arc(candidate, reference, tolerance, lo=.05, hi=1.):
+    """차체 x 창이 비는 급커브에서 두 경로의 같은 호길이 구간을 같은 기준으로 비교한다.
+
+    path_agrees와 마찬가지로 공통 구간 0.25 m·각 5점을 요구하며 외삽하지 않는다.
+    벽 정체를 인증하지 않고, 공통 80%를 넘긴 뒤 갈라지는 먼 분기는 구별하지 못한다.
+    """
+    def ahead(path):
+        path = np.asarray(path, dtype=float)
+        path = path[int(np.argmin(np.linalg.norm(path, axis=1))):]
+        arc = np.r_[0., np.cumsum(np.linalg.norm(np.diff(path, axis=0), axis=1))]
+        keep = (arc >= lo) & (arc <= hi)
+        return path[keep], arc[keep]
+    (first, first_arc), (second, second_arc) = ahead(candidate), ahead(reference)
+    if len(first) < 5 or len(second) < 5:
+        return False
+    start, end = max(first_arc[0], second_arc[0]), min(first_arc[-1], second_arc[-1])
+    if end-start < .25:
+        return False
+    first = first[(first_arc >= start-1e-12) & (first_arc <= end+1e-12)]
+    second = second[(second_arc >= start-1e-12) & (second_arc <= end+1e-12)]
+    if len(first) < 5 or len(second) < 5:
+        return False
+    distances = np.linalg.norm(first[:, None, :]-second[None, :, :], axis=2)
+    return bool(max(np.percentile(np.min(distances, axis=0), 80),
+                    np.percentile(np.min(distances, axis=1), 80)) <= tolerance)
+
+
+def retained_forward_prefix(candidate, reference, details, config):
+    """현재 경로가 전방에서 시작한 경우를 횡방향 이탈과 구별한다.
+
+    현재 긴 직각 벽·유효 이력의 공통 구간은 그대로 요구한다. 시작점은 최소
+    추종 목표 거리(0.30m) 안에서 전방을 향하고, 원점의 접선 수직 오차는 기존
+    앵커 허용량 이내여야 한다. 경로를 뒤로 연장하거나 그 사이를 자유 공간으로
+    기록하지 않는다. 실제 조향/점유/부분 관측 검사는 별도로 유지한다.
+    초기 획득이나 TTL 만료 뒤에는 호출자가 유효 이력을 줄 수 없다.
+    """
+    if (not config.piecewise_wall_trial or candidate is None or reference is None
+            or details.get('wall_model') != 'piecewise_corner'
+            or details.get('boundary_observed_ahead_m', 0.) < config.boundary_min_ahead_m
+            or anchor_error(details, config) <= config.boundary_anchor_error_m):
+        return None
+    path = np.asarray(candidate, dtype=float)
+    if (path.ndim != 2 or path.shape[1] != 2 or len(path) < 5
+            or not np.all(np.isfinite(path))):
+        return None
+    start, tangent = path[0], path[1]-path[0]
+    norm = float(np.linalg.norm(tangent))
+    if norm <= 1e-9 or not 0. < start[0] or np.linalg.norm(start) > .30:
+        return None
+    tangent = tangent/norm
+    along = float(start @ tangent)
+    lateral = abs(float(start[0]*tangent[1]-start[1]*tangent[0]))
+    if (tangent[0] <= 0. or not 0. < along <= .30
+            or lateral > config.boundary_anchor_error_m
+            or int(np.argmin(np.linalg.norm(path, axis=1))) != 0
+            or not path_agrees(path, reference, config.boundary_agreement_m)):
+        return None
+    return dict(start_distance_m=float(np.linalg.norm(start)), along_tangent_m=along,
+                lateral_error_m=lateral, maximum_start_distance_m=.30,
+                observed_prefix_extended=False, unknown_filled=False)
+
+
+def retained_boundary_agreement(candidate, reference, details, config):
+    """현재 긴 벽의 유지 비교. 직각 경로는 공통 호길이 구간도 대조한다.
+
+    x 창만으로는 같은 x를 가진 코너 출구의 서로 다른 길이를 함께 비교할 수 있다.
+    선택형 교통 또는 단독 호길이 옵션의 직각 경로에서 재사용한다. 허용 오차나
+    관측 길이를 늘리지 않으며, 실제 점유/통과 검사는 호출자가 별도로 한다.
+    """
+    if path_agrees(candidate, reference, config.boundary_agreement_m):
+        return 'shared_x'
+    enabled = config.traffic_boundary_refresh_trial or (config.solo_route_only and config.corridor_arc_agreement)
+    if (enabled and config.piecewise_wall_trial
+            and details.get('wall_model') == 'piecewise_corner'
+            and path_agrees_arc(candidate, reference, config.boundary_agreement_m)):
+        return 'shared_arc'
+    return None
+
+
+
+def traffic_corner_prefix(candidate, reference, details, config):
+    """짧은 현재 벽의 지지를 넘기지 않는 코너 경로를 유효 이력과 대조한다.
+
+    벽의 호길이와 오프셋 경로 길이는 다르다. 이 제한 후보는 더 짧은 실제 벽의
+    전방 관측 길이까지만 경로를 남긴다. 최초/만료 이력의 확보와 점유 허가는 별도다.
+    """
+    if (not config.traffic_boundary_refresh_trial or not config.piecewise_wall_trial
+            or not config.short_boundary_prefix_enabled or candidate is None or reference is None
+            or details.get('wall_model') != 'piecewise_corner'
+            or not 0. < details.get('boundary_observed_ahead_m', 0.) < config.boundary_min_ahead_m
+            or anchor_error(details, config) > config.boundary_anchor_error_m):
+        return None, None
+    arc = np.r_[0., np.cumsum(np.linalg.norm(np.diff(candidate, axis=0), axis=1))]
+    nearest = int(np.argmin(np.linalg.norm(candidate, axis=1)))
+    budget = details['boundary_observed_ahead_m']
+    end = int(np.searchsorted(arc, arc[nearest]+budget, side='right'))
+    prefix = candidate[:end].copy()
+    match = retained_boundary_agreement(prefix, reference, details, config)
+    return (prefix, match) if match is not None else (None, None)
+
+
+def boundary_support(points, path, side, config):
+    """유효한 경계 이력 안에서 일치하는 실제 반환만 경로 후보로 사용한다.
+
+    경로 법선에서 예상 벽을 계산하되 관측점을 만들어 추가하지 않는다.
+    이력의 양 끝 너머는 새 경계를 관측할 수 있도록 그대로 둔다. 결과에도
+    기존 연결 간격·적합·길이·형상 검사를 적용하며 모든 원래 점유는 별도 유지한다.
+    """
+    tangent = np.gradient(path, axis=0)
+    tangent /= np.maximum(1e-9, np.linalg.norm(tangent, axis=1))[:, None]
+    sign = 1 if side == 'left' else -1
+    wall = path + sign*config.wall_offset_m*np.column_stack((-tangent[:, 1], tangent[:, 0]))
+    delta = points[:, None, :]-wall[None, :, :]
+    distances = np.linalg.norm(delta, axis=2)
+    nearest = np.argmin(distances, axis=1)
+    index = np.arange(len(points))
+    longitudinal = np.sum(delta[index, nearest]*tangent[nearest], axis=1)
+    outside = ((nearest == 0) & (longitudinal < 0)) | ((nearest == len(wall)-1) & (longitudinal > 0))
+    return points[outside | (distances[index, nearest] <= config.boundary_agreement_m)]
+
+
+def drop_protrusions(points, path, side, config):
+    """경계 지원점에서 기대 벽보다 측정 여유 이상 벗어난 다른 물체의 가장자리를 뺀다.
+
+    boundary_agreement_m는 기억/반대 벽 형상 오차의 허용치라 벽 바로 앞의 얇은
+    기둥 모서리도 통과시킬 수 있고, 그 한 점이 방위 순서의 벽 연결을 끊는다.
+    기대 벽 선분까지의 부호 있는 수직 거리에서 기준 경로의 일정한 치우침(중앙값)을
+    빼고 measurement_padding_m을 넘는 점을 제외한다. 점을 만들거나 옮기지 않으며
+    양 끝 밖 점은 boundary_support와 같이 둔다. 제외한 점도 점유 검사에는 남는다.
+    """
+    tangent = np.gradient(path, axis=0)
+    tangent /= np.maximum(1e-9, np.linalg.norm(tangent, axis=1))[:, None]
+    sign = 1 if side == 'left' else -1
+    wall = path + sign*config.wall_offset_m*np.column_stack((-tangent[:, 1], tangent[:, 0]))
+    start, step = wall[:-1], np.diff(wall, axis=0)
+    length2 = np.maximum(1e-12, np.sum(step*step, axis=1))
+    delta = points[:, None, :]-start[None, :, :]
+    raw = np.sum(delta*step[None], axis=2)/length2
+    fraction = np.clip(raw, 0., 1.)
+    residual = delta-fraction[:, :, None]*step[None]
+    nearest = np.argmin(np.linalg.norm(residual, axis=2), axis=1)
+    index = np.arange(len(points))
+    outside = (((nearest == 0) & (raw[index, nearest] < 0)) |
+               ((nearest == len(step)-1) & (raw[index, nearest] > 1)))
+    # 도로 쪽(경로 방향)이 양수인 선분 법선 성분.
+    inward = -sign*np.column_stack((-step[:, 1], step[:, 0]))/np.sqrt(length2)[:, None]
+    offset = np.sum(residual[index, nearest]*inward[nearest], axis=1)
+    if not np.any(~outside):
+        return points
+    return points[outside | (np.abs(offset-np.median(offset[~outside])) <= config.measurement_padding_m)]
+
+
+def pursue_path(path, speed, config, age, *, speed_cap=None, shape_diagnostic=None):
+    """기존 후륜축 Pure Pursuit와 같은 계산. 보호층 공통 함수를 변경하지 않는다."""
+    rear = np.asarray(path, dtype=float).copy()
+    rear[:, 0] += config.wheelbase_m/2
+    distances = np.linalg.norm(rear, axis=1)
+    nearest = int(np.argmin(distances))
+    ahead = np.flatnonzero((rear[:, 0] > .10) & (np.arange(len(rear)) >= nearest))
+    if len(ahead) < 3 or np.max(distances[ahead]) < .25:
+        raise MotionUnavailable('path_too_short')
+    lookahead = min(.60, max(.30, .30+.12*abs(speed)))
+    target = rear[ahead[np.argmin(np.abs(distances[ahead]-lookahead))]]
+    curvature = float(2*target[1]/max(.01, target@target))
+    steering = float(np.clip(math.atan(config.wheelbase_m*curvature),
+                             -config.max_steering_rad, config.max_steering_rad))
+    arc = np.r_[0., np.cumsum(np.linalg.norm(np.diff(rear, axis=0), axis=1))]
+    remaining = float(arc[-1]-arc[nearest])
+    dx = np.gradient(rear, axis=0)
+    ddx = np.gradient(dx, axis=0)
+    curves = np.abs(dx[:, 0]*ddx[:, 1]-dx[:, 1]*ddx[:, 0])/np.maximum(1e-8, np.linalg.norm(dx, axis=1)**3)
+    preview = np.sqrt(config.lateral_acceleration_mps2/np.maximum(.15, curves[nearest:]) +
+                      4*np.maximum(0., arc[nearest:]-arc[nearest]-.2))
+    shape_cap = min(float(np.min(preview)), math.sqrt(config.lateral_acceleration_mps2/max(.15, abs(curvature))))
+    if shape_diagnostic is not None:
+        shape_diagnostic['original_curve_speed_cap_mps'] = shape_cap
+    cap = min(config.max_speed_mps if speed_cap is None else speed_cap, braking_speed(remaining, age), shape_cap)
+    return cap, steering, remaining
+
+
+def forward_planning_speed(config, measured):
+    """전진 계획의 속력 상계. 원래 센서값·signed 이력/이송을 수정하지 않는다."""
+    if (config.signed_motion_policy == 'forward_drive' and
+            isinstance(measured, (int, float)) and not isinstance(measured, bool) and
+            math.isfinite(measured) and measured < 0.):
+        return abs(measured)
+    return measured
+
+
+def signed_feedback_detail(output, measured, planning):
+    """전진 기하의 속력과 원래 음수 측정을 구별한다. 후방 밀림 안전의 증명은 아니다."""
+    if not (isinstance(measured, (int, float)) and math.isfinite(measured)
+            and measured < 0. and planning >= 0.):
+        return output
+    speed, steering, detail = output
+    detail = dict(detail)
+    for key in ('normal', 'bypass'):
+        if isinstance(detail.get(key), dict) and 'measured_speed_mps' in detail[key]:
+            detail[key] = {**detail[key], 'measured_speed_mps': measured,
+                           'forward_planning_speed_mps': planning}
+    return speed, steering, {**detail, 'measured_speed_mps': measured, 'reverse_motion': True,
+        'forward_planning_speed_mps': planning, 'signed_motion_policy': 'forward_drive',
+        'signed_history_preserved': True, 'rear_rollback_safety_verified': False}
+
+
+class LocalFollow:
+    def __init__(self, config=None):
+        self.config = config or FollowConfig()
+        self.partial_policy = None
