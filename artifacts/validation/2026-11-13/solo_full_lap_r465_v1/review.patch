+#!/usr/bin/env bash
+set -eo pipefail
+cd '/mnt/c/Users/Jinhyeong/Documents/ChatGPT/IT ARENA local'
+artifact='artifacts/validation/2026-11-13/solo_full_lap_r465_v1'
