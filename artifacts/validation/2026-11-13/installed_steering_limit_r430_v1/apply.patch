 class SteeringCalibrationTests(unittest.TestCase):
+    def test_selected_command_range_accepts_narrow_mount_without_expanding_it(self):
+        for direction in (-1, 1):
+            profile = ready_profile(direction=direction)
+            profile.update(safe_min_count=1880, safe_max_count=2120)
+            original = dict(profile)
+            contract = dict(command_limit=.15, wheelbase=.128, track=.1239, wheel_limit=.2)
+            with self.assertRaisesRegex(ValueError, 'range crosses'):
+                cpp_zero_profile(profile, assembly_id='synthetic')
+            header, _ = cpp_zero_profile(profile, assembly_id='synthetic', **contract)
+            self.assertIn('p.minimum=1880; p.maximum=2120;', header)
+            for angle in (-.15, -.075, 0., .075, .15):
+                goal = cad_servo_goal(profile, angle, **contract)
+                self.assertLessEqual(1880, goal['position'])
+                self.assertLessEqual(goal['position'], 2120)
+                self.assertLessEqual(max(abs(goal['left_target_rad']), abs(goal['right_target_rad'])), .2)
+            self.assertEqual(profile, original)
+
+    def test_selected_contract_rejects_invalid_or_outside_cad_values(self):
+        profile = ready_profile()
+        valid = dict(command_limit=.15, wheelbase=.128, track=.1239, wheel_limit=.2)
+        faults = [('command_limit', value) for value in (0., -.1, math.nan, math.inf, True, .6)]
+        faults += [(key, value) for key in ('wheelbase', 'track', 'wheel_limit')
+                   for value in (0., -.1, math.nan, math.inf, True)]
+        faults += [('wheel_limit', .1)]
+        for key, value in faults:
+            with self.subTest(key=key, value=value), self.assertRaises(ValueError):
+                cpp_zero_profile(profile, assembly_id='synthetic', **{**valid, key:value})
+        for command in (math.nan, math.inf, True, .15001, -.15001):
+            with self.subTest(command=command), self.assertRaises(ValueError):
+                cad_servo_goal(profile, command, **valid)
+
+    def test_fractional_count_outside_mount_is_not_rounded_into_acceptance(self):
+        mapping = CadMapping.default()
+        for direction in (-1, 1):
+            profile = ready_profile(direction=direction)
+            profile.update(safe_min_count=1880 if direction == 1 else 1700,
+                           safe_max_count=2300 if direction == 1 else 2120)
+            original = dict(profile)
+            # CAD-relative negative endpoint lies 0.1 count beyond the measured limit.
+            # Rounding would hide this violation; whole-range coverage must reject it first.
+            for offset, accepted in ((-119.9, True), (-120.1, False)):
+                limit = mapping.relative(offset*2*math.pi/4096).equivalent_rad
+                contract = dict(command_limit=limit, wheelbase=.128, track=.1239, wheel_limit=math.pi/6)
+                if accepted:
+                    cpp_zero_profile(profile, assembly_id='synthetic', **contract)
+                    endpoint = cad_servo_goal(profile, limit, **contract)
+                    self.assertEqual(endpoint['position'], 1880 if direction == 1 else 2120)
+                else:
+                    with self.assertRaisesRegex(ValueError, 'range crosses'):
+                        cpp_zero_profile(profile, assembly_id='synthetic', **contract)
+            self.assertEqual(profile, original)
