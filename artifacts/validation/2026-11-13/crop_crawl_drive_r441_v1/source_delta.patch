+def test_off_has_no_worker_or_subscription_and_lease_destroys_everything(fake_ros):
+    clock=[10.];preview=Preview(wall=lambda:clock[0])
+    assert not preview.needs_sync() and preview.worker is None and fake_ros.subs==[]
