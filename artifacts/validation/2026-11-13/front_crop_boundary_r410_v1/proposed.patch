+def _cropped_gap_flanks(order, front, run, valid):
+    """crop 안의 전체 gap에서 잘린 바로 옆 실제 반환만 찾는다.
+
+    바깥 unknown을 건너뛰거나 끝/처음 seam을 잇지 않는다. unknown 배열·폭과
+    각도/거리/속도/과거 위협 검사는 바꾸지 않으며 반환의 거리를 만들지 않는다.
+    """
+    ordered = [int(index) for index in order]
+    members = [int(front[int(index)]) for index in run]
+    low, high = ordered.index(members[0]), ordered.index(members[-1])
+    if low == 0 or high == len(ordered)-1 or ordered[low:high+1] != members:
+        return None
+    left, right = ordered[low-1], ordered[high+1]
+    if not valid[left] or not valid[right]:
+        return None
+    chain = [left, *members, right]
+    if any(abs(b-a) != 1 for a, b in zip(chain, chain[1:])):
+        return None
+    return left, right
 
 
