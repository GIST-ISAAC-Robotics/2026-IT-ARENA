<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
  <world name="wall_raster">
    <physics name="physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="straight_corridor">
      <static>true</static>
      <pose>0 -30.0 .095 0 0 0</pose>
      <link name="sensor_link">
        <sensor name="rplidar_c1" type="gpu_lidar">
          <always_on>true</always_on>
          <update_rate>10.0</update_rate>
          <visualize>false</visualize>
          <topic>/audit/wall_raster/straight_corridor</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>500</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.129026282975434</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.05</min>
              <max>12.0</max>
              <resolution>0.015</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.0</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>
    </model>
    <model name="straight_corridor_side_-1">
