ros_gz_interfaces/Entity entity    # Gazebo Sim entity.
	uint8 NONE      = 0
	uint8 LIGHT     = 1
	uint8 MODEL     = 2
	uint8 LINK      = 3
	uint8 VISUAL    = 4
	uint8 COLLISION = 5
	uint8 SENSOR    = 6
	uint8 JOINT     = 7
	uint64 id      #
	string name    #
	uint8 type     #
geometry_msgs/Pose pose             # Pose of entity.
	Point position
		float64 x
		float64 y
		float64 z
	Quaternion orientation
		float64 x 0
		float64 y 0
		float64 z 0
		float64 w 1
---
bool success                        # Return true if set successfully.
