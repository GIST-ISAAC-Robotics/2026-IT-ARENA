# ROS / colcon build outputs
build/
install/
log/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# 문서 생성 도구의 설치 의존성. 결과물과 생성 소스는 보존합니다.
node_modules/

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Gazebo runtime state
.gz/

# 반복 실행 시 갱신되는 진단 출력. 검증 요약은 docs/activity에 남깁니다.
artifacts/tests/

# A2 원시 센서 기록은 로컬 보존. 수 GB RGB 자료를 Git에 우발적으로 올리지 않습니다.
# manifest/parameters/검증 요약은 별도로 추적 가능합니다.
artifacts/**/sensor_recording/bag/
artifacts/**/sensor_recording/receipt.jsonl
artifacts/**/sensor_recording/ready.json

# G0 고빈도 원시 광선/상세 수신 기록은 로컬 보존하고 요약·해시만 추적합니다.
