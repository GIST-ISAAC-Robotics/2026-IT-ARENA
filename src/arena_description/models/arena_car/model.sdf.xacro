<?xml version="1.0"?>
<sdf version="1.10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="body_length" default="0.20"/>
  <xacro:arg name="body_width" default="0.15"/>
  <xacro:arg name="body_height" default="0.06"/>
  <xacro:arg name="body_mass" default="1.5"/>
  <xacro:arg name="wheelbase" default="0.145"/>
  <xacro:arg name="track_width" default="0.135"/>
  <xacro:arg name="wheel_radius" default="0.025"/>
  <xacro:arg name="wheel_width" default="0.012"/>
  <xacro:arg name="max_steering_angle" default="0.45"/>
  <xacro:arg name="max_speed" default="2.0"/>
  <xacro:arg name="d435i_x" default="0.055"/>
  <xacro:arg name="d435i_y" default="0.0"/>
  <xacro:arg name="d435i_z" default="0.075"/>
  <xacro:arg name="d435i_roll" default="0.0"/>
  <xacro:arg name="d435i_pitch" default="0.0"/>
  <xacro:arg name="d435i_yaw" default="0.0"/>
  <xacro:arg name="d435i_horizontal_fov" default="1.2043"/>
  <xacro:arg name="d435i_width" default="848"/>
  <xacro:arg name="d435i_height" default="480"/>
  <xacro:arg name="d435i_rate" default="30.0"/>
  <xacro:arg name="d435i_near" default="0.10"/>
  <xacro:arg name="d435i_far" default="6.0"/>

  <xacro:property name="body_length" value="$(arg body_length)"/>
  <xacro:property name="body_width" value="$(arg body_width)"/>
  <xacro:property name="body_height" value="$(arg body_height)"/>
  <xacro:property name="body_mass" value="$(arg body_mass)"/>
  <xacro:property name="wheelbase" value="$(arg wheelbase)"/>
  <xacro:property name="track_width" value="$(arg track_width)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="$(arg wheel_width)"/>
  <xacro:property name="max_steering_angle" value="$(arg max_steering_angle)"/>
  <xacro:property name="max_speed" value="$(arg max_speed)"/>
  <xacro:property name="d435i_x" value="$(arg d435i_x)"/>
  <xacro:property name="d435i_y" value="$(arg d435i_y)"/>
  <xacro:property name="d435i_z" value="$(arg d435i_z)"/>
  <xacro:property name="d435i_roll" value="$(arg d435i_roll)"/>
  <xacro:property name="d435i_pitch" value="$(arg d435i_pitch)"/>
  <xacro:property name="d435i_yaw" value="$(arg d435i_yaw)"/>
  <xacro:property name="d435i_horizontal_fov" value="$(arg d435i_horizontal_fov)"/>
  <xacro:property name="d435i_width" value="$(arg d435i_width)"/>
  <xacro:property name="d435i_height" value="$(arg d435i_height)"/>
  <xacro:property name="d435i_rate" value="$(arg d435i_rate)"/>
  <xacro:property name="d435i_near" value="$(arg d435i_near)"/>
  <xacro:property name="d435i_far" value="$(arg d435i_far)"/>
  <xacro:property name="wheel_mass" value="0.04"/>
  <xacro:property name="steering_link_mass" value="0.01"/>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass>${mass}</mass>
      <inertia>
        <ixx>${mass * (y * y + z * z) / 12.0}</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>${mass * (x * x + z * z) / 12.0}</iyy>
        <iyz>0</iyz>
        <izz>${mass * (x * x + y * y) / 12.0}</izz>
      </inertia>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <mass>${mass}</mass>
      <inertia>
        <ixx>${mass * (3.0 * radius * radius + width * width) / 12.0}</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>${mass * (3.0 * radius * radius + width * width) / 12.0}</iyy>
        <iyz>0</iyz>
        <izz>${mass * radius * radius / 2.0}</izz>
      </inertia>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_link" params="name x y">
    <link name="${name}">
      <pose>${x} ${y} ${wheel_radius} ${-pi / 2.0} 0 0</pose>
      <xacro:wheel_inertial mass="${wheel_mass}" radius="${wheel_radius}" width="${wheel_width}"/>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>${wheel_radius}</radius>
            <length>${wheel_width}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>${wheel_radius}</radius>
            <length>${wheel_width}</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.0</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="wheel_joint" params="name parent child">
    <joint name="${name}" type="revolute">
      <parent>${parent}</parent>
      <child>${child}</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>5.0</effort>
          <velocity>200.0</velocity>
        </limit>
      </axis>
    </joint>
  </xacro:macro>

  <model name="arena_car">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="chassis">
      <pose>0 0 ${wheel_radius + body_height / 2.0} 0 0 0</pose>
      <xacro:box_inertial mass="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
      <visual name="visual">
        <geometry>
          <box><size>${body_length} ${body_width} ${body_height}</size></box>
        </geometry>
        <material>
          <ambient>0.04 0.24 0.65 1</ambient>
          <diffuse>0.05 0.32 0.85 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box><size>${body_length} ${body_width} ${body_height}</size></box>
        </geometry>
      </collision>
    </link>

    <frame name="base_link" attached_to="chassis">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
    </frame>

    <link name="d435i_link">
      <pose>${d435i_x} ${d435i_y} ${d435i_z} ${d435i_roll} ${d435i_pitch} ${d435i_yaw}</pose>
      <xacro:box_inertial mass="0.072" x="0.09" y="0.025" z="0.025"/>
      <visual name="body_visual">
        <geometry><box><size>0.09 0.025 0.025</size></box></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
      <sensor name="d435i_rgbd" type="rgbd_camera">
        <camera>
          <horizontal_fov>${d435i_horizontal_fov}</horizontal_fov>
          <image>
            <width>${int(d435i_width)}</width>
            <height>${int(d435i_height)}</height>
          </image>
          <clip>
            <near>${d435i_near}</near>
            <far>${d435i_far}</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>${d435i_rate}</update_rate>
        <visualize>false</visualize>
        <topic>camera</topic>
      </sensor>
      <sensor name="d435i_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <topic>camera/imu</topic>
      </sensor>
    </link>
    <joint name="d435i_fixed_joint" type="fixed">
      <parent>chassis</parent>
      <child>d435i_link</child>
    </joint>

    <xacro:wheel_link name="front_left_wheel" x="${wheelbase / 2.0}" y="${track_width / 2.0}"/>
    <xacro:wheel_link name="front_right_wheel" x="${wheelbase / 2.0}" y="${-track_width / 2.0}"/>
    <xacro:wheel_link name="rear_left_wheel" x="${-wheelbase / 2.0}" y="${track_width / 2.0}"/>
    <xacro:wheel_link name="rear_right_wheel" x="${-wheelbase / 2.0}" y="${-track_width / 2.0}"/>

    <link name="front_left_steering_link">
      <pose>${wheelbase / 2.0} ${track_width / 2.0} ${wheel_radius} 0 0 0</pose>
      <xacro:box_inertial mass="${steering_link_mass}" x="0.008" y="0.008" z="0.012"/>
      <visual name="visual">
        <geometry><cylinder><radius>0.004</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
      </visual>
    </link>
    <link name="front_right_steering_link">
      <pose>${wheelbase / 2.0} ${-track_width / 2.0} ${wheel_radius} 0 0 0</pose>
      <xacro:box_inertial mass="${steering_link_mass}" x="0.008" y="0.008" z="0.012"/>
      <visual name="visual">
        <geometry><cylinder><radius>0.004</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
      </visual>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>${-max_steering_angle}</lower>
          <upper>${max_steering_angle}</upper>
          <effort>5.0</effort>
          <velocity>8.0</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steering_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>${-max_steering_angle}</lower>
          <upper>${max_steering_angle}</upper>
          <effort>5.0</effort>
          <velocity>8.0</velocity>
        </limit>
      </axis>
    </joint>

    <xacro:wheel_joint name="front_left_wheel_joint" parent="front_left_steering_link" child="front_left_wheel"/>
    <xacro:wheel_joint name="front_right_wheel_joint" parent="front_right_steering_link" child="front_right_wheel"/>
    <xacro:wheel_joint name="rear_left_wheel_joint" parent="chassis" child="rear_left_wheel"/>
    <xacro:wheel_joint name="rear_right_wheel_joint" parent="chassis" child="rear_right_wheel"/>

    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>${track_width}</kingpin_width>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <steering_limit>${max_steering_angle}</steering_limit>
      <min_velocity>${-max_speed}</min_velocity>
      <max_velocity>${max_speed}</max_velocity>
      <min_acceleration>-4.0</min_acceleration>
      <max_acceleration>4.0</max_acceleration>
      <min_jerk>-20.0</min_jerk>
      <max_jerk>20.0</max_jerk>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/model/arena_car/cmd_vel</topic>
      <odom_topic>/model/arena_car/odometry</odom_topic>
      <tf_topic>/model/arena_car/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/arena_car/joint_state</topic>
    </plugin>
  </model>
</sdf>
